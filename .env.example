# ── LLM ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Embeddings (ChromaDB default — no API key needed) ────────────────────────
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DEVICE=cpu

# ── ChromaDB (default vector store) ─────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma

# ── Qdrant (set USE_QDRANT=true to activate) ─────────────────────────────────
USE_QDRANT=false
QDRANT_URL=https://your-cluster.qdrant.io   # omit for local disk store
QDRANT_API_KEY=...
QDRANT_PATH=./data/qdrant                   # local path (if QDRANT_URL not set)
QDRANT_COLLECTION=senstat
QDRANT_COLPALI_COLLECTION=senstat_colpali

# ── Qdrant dense embedder ────────────────────────────────────────────────────
# local (default): same EMBEDDING_MODEL as ChromaDB, no extra service
# voyage: voyage-3-large, paid API, needs VOYAGE_API_KEY
# A collection embedded with one cannot be queried with the other: re-index.
QDRANT_DENSE_EMBEDDER=local
VOYAGE_API_KEY=...

# ── Cohere Rerank v3.5 (set USE_COHERE_RERANK=true to activate) ──────────────
USE_COHERE_RERANK=false
COHERE_API_KEY=...

# ── ColPali visual retrieval (set USE_COLPALI=true to activate) ──────────────
# Requires: pip install colpali-engine  +  Qdrant server >= 1.10
# ColPali adds visual page retrieval for scanned PDFs alongside text search.
USE_COLPALI=false
COLPALI_TOP_K=3   # visual pages merged into candidate pool before reranking

# ── Data directories ──────────────────────────────────────────────────────────
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
